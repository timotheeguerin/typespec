{
  "name": "@typespec/ai-linter",
  "version": "0.1.0",
  "description": "Experimental TypeSpec AI lint rules and CLI",
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./copilot": "./dist/src/copilot.js",
    "./testing": "./dist/src/testing.js"
  },
  "bin": {
    "tsp-ai-lint": "./cmd/tsp-ai-lint.js"
  },
  "files": [
    "dist/src/**",
    "cmd/**",
    "rules/**"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "clean": "rimraf dist temp"
  },
  "dependencies": {
    "@typespec/compiler": "workspace:^",
    "@typespec/tspq": "workspace:^",
    "yargs": "catalog:"
  },
  "optionalDependencies": {
    "@github/copilot-sdk": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/yargs": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
